{
  "manifest_version": 3,
  "name": "Clousight — Cloud Status Monitor",
  "version": "0.1.0",
  "description": "Watch multi-cloud service status (AWS, Azure, GCP, Cloudflare, Alibaba, Tencent & more) locally. No account, no server.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://status.aws.amazon.com/*",
    "https://azure.status.microsoft/*",
    "https://status.cloud.google.com/*",
    "https://status.alibabacloud.com/*",
    "https://status.tencentcloud.com/*",
    "https://www.cloudflarestatus.com/*",
    "https://status.digitalocean.com/*",
    "https://status.linode.com/*"
  ],
  "optional_host_permissions": [
    "https://status.huaweicloud.com/*",
    "https://status.volcengine.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
